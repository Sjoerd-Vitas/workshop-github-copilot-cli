---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameFilters from '../components/GameFilters.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && <GameFilters categories={categories} publishers={publishers} />}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <div id="no-matches" hidden>
          <EmptyState text="No games match the selected filters." />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const noMatches = document.getElementById('no-matches');
  const count = document.querySelector<HTMLElement>('[data-testid="filter-count"]');
  const clear = document.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]');

  /** All filter checkboxes with the given group name (`category` or `publisher`). */
  function checkboxes(name: string): HTMLInputElement[] {
    return Array.from(form?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`) ?? []);
  }

  /** Values of the checked checkboxes in the given group. */
  function selected(name: string): string[] {
    return checkboxes(name).filter((box) => box.checked).map((box) => box.value);
  }

  /** Shows only cards matching the selected filters (OR within a group, AND across groups) and syncs the count and URL. */
  function applyFilters(): void {
    const categoryIds = selected('category');
    const publisherIds = selected('publisher');
    let visible = 0;
    for (const card of cards) {
      const matchesCategory = categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
      const matchesPublisher = publisherIds.length === 0 || publisherIds.includes(card.dataset.publisherId ?? '');
      const show = matchesCategory && matchesPublisher;
      card.hidden = !show;
      if (show) visible++;
    }
    if (grid) grid.hidden = visible === 0;
    if (noMatches) noMatches.hidden = visible !== 0;
    if (count) count.textContent = `Showing ${visible} of ${cards.length} games`;

    const params = new URLSearchParams();
    if (categoryIds.length > 0) params.set('category', categoryIds.join(','));
    if (publisherIds.length > 0) params.set('publisher', publisherIds.join(','));
    const query = params.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  if (form) {
    const params = new URLSearchParams(location.search);
    for (const name of ['category', 'publisher']) {
      const ids = (params.get(name) ?? '').split(',');
      for (const box of checkboxes(name)) box.checked = ids.includes(box.value);
    }
    form.addEventListener('change', applyFilters);
    form.addEventListener('submit', (event) => event.preventDefault());
    clear?.addEventListener('click', () => {
      for (const box of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) box.checked = false;
      applyFilters();
    });
    applyFilters();
  }
</script>
